@startuml

title Platoon

|Seguidor - Sensores|
start

repeat
  :Recolher dados de câmara, LiDAR e ultrassons;
  :Recolher dados de GPS, velocidade e direção;
  :Recolher dados de pressão, temperatura e travões;

  |Seguidor - PredMaint|
  :Avaliar estado do veículo;
  :Classificar estado: normal / aviso / crítico;

  if (Estado crítico ou aviso?) then (sim)

    |Seguidor - COMM|
    :Enviar estado ao veículo líder;

    |Líder - COMM|
    :Receber estado do seguidor;

    |Líder - PlatMgmt|
    :Atualizar visão do platoon;
    :Avaliar impacto no platoon;

    if (Condição crítica?) then (sim)

      :Determinar procedimento de paragem;

      |Líder - VC|
      :Enviar comandos de paragem aos atuadores do líder;

      |Líder - COMM|
      :Enviar comando de paragem aos seguidores;

      |Seguidor - COMM|
      :Receber comando de paragem;

      |Seguidor - VC|
      :Enviar comandos de paragem aos atuadores do seguidor;

      |Seguidor - Sensores|
      :Platoon parado em segurança;
      stop

    else (aviso)

      |Seguidor - VC|
      :Calcular rota via NAV;
      :Tomar decisões de controlo;
      :Enviar comandos para atuadores;

    endif

  else (normal)

    |Seguidor - VC|
    :Calcular rota via NAV;
    :Tomar decisões de controlo;
    :Enviar comandos para atuadores;

  endif

  |Seguidor - Sensores|

repeat while (Operação ativa?)

stop

@enduml